# Generated by podman-static install.sh from storage.conf.in.
# Storage lives inside the install prefix so it never collides with a
# distro podman store. Regenerate with uninstall.sh + install.sh.
[storage]
driver = "overlay"
graphroot = "@PREFIX@/var/lib/containers/storage"
runroot = "@PREFIX@/var/run/containers/storage"

[storage.options.overlay]
mount_program = "@PREFIX@/bin/fuse-overlayfs"
mountopt = "nodev"
ignore_chown_errors = "true"
