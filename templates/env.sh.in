# Generated by podman-static install.sh from env.sh.in.
# Source this file to use the podman-static install in this prefix:
#   . "@PREFIX@/bin/podman-env.sh"
PODMAN_STATIC_PREFIX='@PREFIX@'
case ":$PATH:" in
  *":$PODMAN_STATIC_PREFIX/bin:"*) ;;
  *) PATH="$PODMAN_STATIC_PREFIX/bin:$PATH" ;;
esac
export PODMAN_STATIC_PREFIX PATH
export CONTAINERS_CONF='@PREFIX@/etc/containers/containers.conf'
export CONTAINERS_STORAGE_CONF='@PREFIX@/etc/containers/storage.conf'
export CONTAINERS_REGISTRIES_CONF='@PREFIX@/etc/containers/registries.conf'
# Only fall back to the bundled (permissive) policy when the host has none,
# so a distro policy.json keeps enforcing signature verification.
if [ ! -e /etc/containers/policy.json ]; then
  export CONTAINERS_POLICY_JSON='@PREFIX@/etc/containers/policy.json'
fi
