# Generated by podman-static install.sh from containers.conf.in.
# Regenerate with uninstall.sh + install.sh; do not edit in place.
[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
conmon_path = ["@PREFIX@/lib/podman/conmon"]
helper_binaries_dir = ["@PREFIX@/lib/podman", "@PREFIX@/bin"]
runtime = "crun"

[engine.runtimes]
crun = ["@PREFIX@/bin/crun"]
runc = ["@PREFIX@/bin/runc"]

[containers]
init_path = "@PREFIX@/lib/podman/catatonit"
seccomp_profile = "@PREFIX@/share/seccomp.json"
